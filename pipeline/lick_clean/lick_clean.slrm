#!/bin/bash
# Lick-contact artifact removal before sorting (lick_clean_raw.py): writes a cleaned copy of one session folder.
# Submit from the SpikeSortingEF folder:
#   sbatch pipeline/lick_clean/lick_clean.slrm <session_dir> <out_parent_dir> [--licks <lick_onsets_file>] [--find detect] [--model lowrank|template]
# e.g. sbatch pipeline/lick_clean/lick_clean.slrm \
#        /n/netscratch/bsabatini_lab/Lab/eferenczi/spikesorting_eftest/aind_input/20260805_EF405_g0 \
#        /n/netscratch/bsabatini_lab/Lab/eferenczi/spikesorting_eftest2/aind_input/todo
# CPU only (single-threaded python), so it runs on the FASRC 'test' partition with the Kempner account: no GPU (2026-10-27,
# after Job Defense Shield flagged GPUs held at 0% by the earlier kempner_requeue version; Kempner has no CPU partition and
# HMS groups cannot use shared / serial_requeue). 'test' allows 12 h and at most 5 jobs per user: resort_batch.sh submits at
# most 5 at a time. Measured: 35-50 min per ~50-min session, peak memory ~14 GB on the busiest sessions.
# A job that is stopped (time limit, node failure) leaves <session>.partial; resubmitting removes it and starts again.
#SBATCH --job-name=lick_clean
#SBATCH --partition=test
#SBATCH --account=kempner_bsabatini_lab
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=1
#SBATCH --mem=20G
#SBATCH --time=02:30:00
#SBATCH --output=lick_clean_%j.out
#SBATCH --error=lick_clean_%j.err

set -euo pipefail
SRC=${1:?usage: sbatch lick_clean.slrm <session_dir> <out_parent_dir>}
OUT=${2:?usage: sbatch lick_clean.slrm <session_dir> <out_parent_dir>}
PY=/n/holylabs/LABS/bsabatini_lab/Users/eferenczi/envs/raw_extract/bin/python
[ -x "$PY" ] || { echo "python env not found: $PY"; exit 1; }
mkdir -p "$OUT"
echo "[$(date)] $SRC -> $OUT on $(hostname)"
"$PY" "${SLURM_SUBMIT_DIR:?}/pipeline/lick_clean/lick_clean_raw.py" "$SRC" "$OUT" "${@:3}"   # extra options, e.g. --licks <file>
echo "[$(date)] done"
